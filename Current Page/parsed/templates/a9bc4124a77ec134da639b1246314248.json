{"components/gordonbyte/common/featured-product/featured-product":"{{#if theme_settings.gb-highlight-product-section-name }}\n  <div class=\"highlight-product{{#if theme_settings.gb-highlight-product-img-position }} {{theme_settings.gb-highlight-product-img-position }}-highlight{{/if}}\" data-highlightid=\"{{ theme_settings.gb-highlight-product-section-name }}\">\n    <div class=\"container\">\n      <div class=\"flex-align\">\n        <div class=\"highight-img\">\n          <img src=\"\" alt=\"\">\n        </div>\n\n        <div class=\"highlight-info\">\n\n          <h2></h2>\n\n          <div class=\"highlight-price\"></div>\n\n          <div class=\"highight-atc\">\n            <a href=\"#\" class=\"button btn button--primary style-action\"><span>{{ theme_settings.gb-highlight-buy-btn }}</span></a>\n          </div>\n\n          {{#if theme_settings.gb-highlight-product-enable-social-share }}\n          <div class=\"highlight-social\"></div>\n          {{/if}}\n\n        </div>\n\n      </div>\n    </div>\n  </div><!--.highlight-product ends-->\n\n\n{{/if}}\n"}
