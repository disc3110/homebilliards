              <a class=\"navUser-action navUser-action--storeCredit\"\r\n                   data-dropdown=\"storeCredit-dropdown\"\r\n                   data-options=\"align:bottom\"\r\n                   href=\"{{urls.cart}}\"\r\n                   aria-label=\"{{lang 'common.store_credit_overview' credit=customer.store_credit.formatted}}\" \r\n                >\r\n                    <span class=\"navUser-action-divider\">\r\n                        {{lang 'common.store_credit_overview' credit=customer.store_credit.formatted}}\r\n                    </span>\r\n                </a>\r\n                <div class=\"dropdown-menu\" id=\"storeCredit-dropdown\" data-dropdown-content aria-hidden=\"true\">\r\n                    {{{lang 'common.store_credit' store_credit=customer.store_credit.formatted}}}\r\n                </div>\r\n            </li>\r\n        {{/if}}\r\n        {{#or (if theme_settings.logo-position '===' 'left') (if theme_settings.logo-position '===' 'center')}}\r\n        <li class=\"navUser-item megamen\">\r\n            <button class=\"navUser-action navUser-action--quickSearch\"\r\n               type=\"button\"\r\n               id=\"quick-search-expand\"\r\n               data-search=\"quickSearch\"\r\n               aria-controls=\"quickSearch\"\r\n               aria-label=\"{{lang 'common.search'}}\"\r\n            >\r\n            {{> components/gordonbyte/common/search-icon }}\r\n            <span class=\"headerTitle\">{{lang 'common.search'}}</span>\r\n            </button>\r\n        </li>\r\n        {{/or}}\r\n        {{#if settings.gift_certificates_enabled}}\r\n            <li class=\"navUser-item\">\r\n                <a class=\"navUser-action\"\r\n                   href=\"{{urls.gift_certificate.purchase}}\"\r\n                   aria-label=\"{{lang 'common.gift_cert'}}\"\r\n                >\r\n                {{> components/gordonbyte/common/gift-icon }}\r\n                    <span class=\"headerTitle\">{{lang 'common.gift_cert'}}\r\n                </a>\r\n            </li> \r\n        {{/if}}\r\n\r\n        <li class=\"navUser-item navUser-item--account\"> \r\n            {{#if customer}}\r\n                <a class=\"navUser-action\"\r\n                   href=\"{{urls.account.index}}\"\r\n                   aria-label=\"{{lang 'common.account'}}\"\r\n                >\r\n                    {{> components/gordonbyte/common/account-icon }}\r\n                    <span class=\"headerTitle\">{{lang 'common.account'}}</span>\r\n                </a>\r\n                <a class=\"navUser-action hidden\"\r\n                   href=\"{{urls.auth.logout}}\"\r\n                   aria-label=\"{{lang 'common.logout'}}\"\r\n                >\r\n                    {{lang 'common.logout'}}\r\n                </a>\r\n            {{else}}\r\n                <a class=\"navUser-action\"\r\n                   href=\"{{urls.auth.login}}\"\r\n                   aria-label=\"{{lang 'common.login'}}\"\r\n                >\r\n                {{> components/gordonbyte/common/account-icon }}\r\n                <span class=\"headerTitle\">{{lang 'common.login'}}</span>\r\n                </a>\r\n                {{#if settings.account_creation_enabled}}\r\n                    <span class=\"navUser-or hidden\">{{lang 'common.or'}}</span>\r\n                    <a class=\"navUser-action hidden\"\r\n                       href=\"{{urls.auth.create_account}}\"\r\n                       aria-label=\"{{lang 'common.sign_up'}}\"\r\n                    >\r\n                        {{lang 'common.sign_up'}}\r\n                    </a>\r\n                {{/if}}\r\n            {{/if}}\r\n        </li>\r\n\r\n        <li class=\"navUser-item navUser-item--cart\">\r\n            <a class=\"navUser-action\"\r\n               data-cart-preview\r\n               data-dropdown=\"cart-preview-dropdown\"\r\n               data-options=\"align:right\"\r\n               href=\"{{urls.cart}}\"\r\n               aria-label=\"{{lang 'cart.nav_aria_label'}}\"\r\n            >\r\n                {{> components/gordonbyte/common/cart-icon}}\r\n                <span class=\"navUser-item-cartLabel headerTitle\">{{lang 'common.cart'}}</span>\r\n                <span class=\"countPill cart-quantity\"></span>\r\n            </a>\r\n\r\n            <div class=\"dropdown-menu\" id=\"cart-preview-dropdown\" data-dropdown-content aria-hidden=\"true\"></div>\r\n        </li>\r\n\r\n    </ul>\r\n    {{#or customer (unless settings.hide_price_from_guests)}}\r\n        <div class=\"navUser-item--currency\">\r\n            {{> components/common/currency-selector}}\r\n        </div>\r\n    {{/or}}\r\n\r\n    {{#or (if theme_settings.logo-position '===' 'left') (if theme_settings.logo-position '===' 'center')}}\r\n    <!-- separate Search style -->\r\n    <div class=\"dropdown dropdown--quickSearch\" id=\"quickSearch\" aria-hidden=\"true\" tabindex=\"-1\" data-prevent-quick-search-close>\r\n        <div class=\"searchHolder\">\r\n        <div class=\"closeSearch\">\r\n            <button class=\"closeSearch-btn\">Close</button>\r\n        </div><!--.closeSearch ends-->\r\n        {{> components/gordonbyte/common/quick-search name='nav-quick-search'}}\r\n        </div><!--.searchHolder ends-->\r\n    </div>\r\n    <!-- separate Search style -->\r\n    {{/or}}\r\n</nav>\r\n\r\n\r\n<nav class=\"container-after-logo\">\r\n    <form class=\"form\" action=\"/search.php\" method=\"get\" role=\"search\">\r\n        <label class=\"form-label is-srOnly\" for=\"search_query\">Search</label>\r\n        <input\r\n            class=\"form-input\"\r\n            name=\"search_query\"\r\n            id=\"search_query\"\r\n            type=\"text\"\r\n            value=\"{{forms.search.query}}\"\r\n            placeholder=\"Look for billiards, games, and lifestyle equipment\"\r\n            aria-label=\"Search\"\r\n        >\r\n        <button class=\"button button--icon\" type=\"submit\" aria-label=\"Submit search\">\r\n            <span>SEARCH</span>\r\n            <svg role=\"img\" style=\"width:16px;height:16px;\" aria-labelledby=\"quicksearchicontitle  quicksearchicondesc\" height=\"20\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" x=\"0px\" y=\"0px\" viewBox=\"0 0 413.1 413.1\" enable-background=\"new 0 0 413.1 413.1\" xml:space=\"preserve\">\r\n            \t<title id=\"quicksearchicontitle\">Magnifying glass image</title>\r\n            \t<desc id=\"quicksearchicondesc\">Large red circle with a black border</desc>\r\n            \t<path d=\"M289.5,49.6c-66.1-66.2-173.8-66.2-239.9,0c-66.1,66.1-66.1,173.8,0,239.9c63.9,63.9,166.4,66.1,233,6.6l13.5,13.5\r\n            \t\t\t\t\t\t\t\t\t  c-3.4,8.6-1.6,18.7,5.3,25.6l71,71c9.3,9.3,24.5,9.3,33.8,0c9.3-9.3,9.3-24.5,0-33.8l-71-71c-6.9-6.9-17-8.7-25.6-5.3l-13.5-13.5\r\n            \t\t\t\t\t\t\t\t\t  C355.6,216,353.4,113.5,289.5,49.6z M69.9,269.3c-55-55-55-144.4,0-199.4c55-55,144.4-55,199.4,0s55,144.4,0,199.4\r\n            \t\t\t\t\t\t\t\t\t  S124.9,324.2,69.9,269.3z\"></path>\r\n              </svg>\r\n        </button>\r\n        <div class=\"main-container-search-result\">\r\n            <div class=\"cls-btn\">&times;</div>\r\n           \r\n            <div class=\"container-search-result\">\r\n            </div>\r\n                        <div class=\"container-search-fix-category\">\r\n                      {{#if theme_settings.gb-quicksearch-search-featured }}\r\n                          <div class=\"searchfeatured-products\">\r\n                              <h3>Featured</h3>\r\n                              <ul>\r\n                              {{#each (limit products.featured 5) }}\r\n                                  <li class=\"searchproduct-list-aoc\">\r\n                                    <a href=\"{{url}}\">\r\n                                        {{> components/common/responsive-img\r\n                                            image=image\r\n                                            class=\"custom-image\"\r\n                                            fallback_size=theme_settings.productgallery_size\r\n                                            lazyload=theme_settings.lazyload_mode\r\n                                            default_image=theme_settings.default_image_product\r\n                                        }}\r\n                                        {{name}}\r\n                                    </a>\r\n                                  </li>\r\n                              {{/each}}\r\n                              </ul>\r\n                          </div><!--.searchfeatured-products ends-->\r\n                      {{/if}}\r\n                        {{#if theme_settings.gb-quicksearch-search-popular }}\r\n                              <div class=\"searchpopular-products\">\r\n                                  <h3>Most Popular</h3>\r\n                                  <ul>\r\n                                  {{#each (limit products.top_sellers 5) }}\r\n                                      <li class=\"searchproduct-list\">\r\n                                          <a href=\"{{url}}\">\r\n                                              {{> components/common/responsive-img\r\n                                                  image=image\r\n                                                  class=\"custom-image\"\r\n                                                  fallback_size=theme_settings.productgallery_size\r\n                                                  lazyload=theme_settings.lazyload_mode\r\n                                                  default_image=theme_settings.default_image_product\r\n                                              }}\r\n                                              {{name}}\r\n                                          </a>\r\n                                      </li>\r\n                                  {{/each}}\r\n                                  </ul>\r\n                              </div><!--.searchpopular-products ends-->\r\n                       {{/if}}\r\n                        {{#if theme_settings.gb-quicksearch-search-latest }}\r\n                          <div class=\"searchlatest-products\">\r\n                            <h3>Latest</h3>\r\n                            <ul>\r\n                            {{#each (limit products.new 5) }}\r\n                                <li class=\"searchproduct-list\">\r\n                                  <a href=\"{{url}}\">\r\n                                       {{> components/common/responsive-img\r\n                                              image=image\r\n                                              class=\"custom-image\"\r\n                                              fallback_size=theme_settings.productgallery_size\r\n                                              lazyload=theme_settings.lazyload_mode\r\n                                              default_image=theme_settings.default_image_product\r\n                                        }}\r\n                                      {{name}}\r\n                                  </a>\r\n                                </li>\r\n                            {{/each}}\r\n                            </ul>\r\n                          </div><!--.searchlatest-products ends-->\r\n                      {{/if}}\r\n\r\n            </div>\r\n        </div>\r\n    </form>\r\n    <div class=\"navUser-cart\">\r\n            <a class=\"navUser-action\"\r\n               href=\"/cart.php\"\r\n               aria-label=\"{{lang 'cart.nav_aria_label'}}\"\r\n            >\r\n                {{> components/gordonbyte/common/cart-icon}}\r\n                <span class=\"label-cart\" style=\"text-transform:capitalize;\">My Cart</span> \r\n                <span class=\"countPill cart-quantity\"></span>\r\n            </a>\r\n\r\n            <div class=\"dropdown-menu\" id=\"cart-preview-dropdown\" data-dropdown-content aria-hidden=\"true\"></div>\r\n    </div>\r\n\r\n</nav>\r\n\r\n<script>\r\ndocument.addEventListener(\"DOMContentLoaded\", function () {\r\n    const searchInput = document.getElementById(\"search_query\");\r\n    const resultsBox = document.querySelector(\".container-search-result\");\r\n    const resultsBoxMain = document.querySelector(\".main-container-search-result\");\r\n    const cls = document.querySelector('.cls-btn');\r\n    \r\n    cls.addEventListener('click',function(){\r\n         resultsBoxMain.style.display = \"none\";\r\n        searchInput.value = \"\";\r\n    });\r\n\r\n    let debounceTimer;\r\n\r\n    searchInput.addEventListener(\"input\", function () {\r\n        const query = searchInput.value.trim();\r\n\r\n        // Clear previous timer\r\n        clearTimeout(debounceTimer);\r\n\r\n        // Only proceed if at least 3 characters\r\n        if (query.length >= 3) {\r\n     \r\n            resultsBox.innerHTML = '<div class=\"loader\">Loading...</div>';\r\n\r\n            debounceTimer = setTimeout(() => {\r\n                // Simulate fetch request\r\n                fetch(`/search.php?search_query=${encodeURIComponent(query)}`)\r\n                    .then(response => {\r\n                        if (!response.ok) throw new Error(\"Network error\");\r\n                        return response.text(); // or .json() based on your actual response\r\n                    })\r\n                    .then(data => {\r\n                        resultsBoxMain.style.display = \"block\";\r\n                        resultsBox.innerHTML = `<div class=\"results\">Results for \"${query}\"</div>`;\r\n                        // You can display actual results using `data` if needed\r\n                        const parser = new DOMParser();\r\n                        const doc = parser.parseFromString(data, 'text/html');\r\n                        // Change this selector to match the exact container you want\r\n                        const results = doc.querySelector('[data-list-name=\"Search Results\"]');\r\n                       if (results) {\r\n                            resultsBox.innerHTML = results.innerHTML; \r\n                        } else {\r\n                            resultsBox.innerHTML = `<div class=\"no-results\">No results found for \"${query}\".</div>`;\r\n                        }\r\n                    })\r\n                    .catch(err => {\r\n                        console.error(\"Fetch error:\", err);\r\n                        resultsBox.innerHTML = '<div class=\"error\">Something went wrong</div>';\r\n                    });\r\n            }, 500); // Delay execution for 500ms\r\n        } else {\r\n            resultsBoxMain.style.display = \"none\";\r\n            resultsBox.innerHTML = \"\"; // Clear results if less than 3 characters\r\n        }\r\n    });\r\n    \r\n});\r\n</script>\r\n","components/gordonbyte/common/quick-search":"<form class=\"form\" onsubmit=\"return false\" data-url=\"{{urls.search}}\" data-quick-search-form>\n    <fieldset class=\"form-fieldset\">\n        <div class=\"form-field\">\n\n            <label class=\"is-srOnly\" for=\"{{name}}\">{{lang \"search.quick_search.input_label\"}}</label>\n            <input class=\"form-input\"\n                   data-search-quick\n                   name=\"{{name}}\"\n                   id=\"{{name}}\"\n                   data-error-message=\"{{lang 'search.error.empty_field'}}\"\n                   placeholder=\"{{lang 'search.quick_search.input_placeholder'}}\"\n                   autocomplete=\"off\"\n            >\n\n            <label class=\"is-srOnly\" for=\"search-bar-submit-btn\">Submit Button</label>\n            <input id=\"search-bar-submit-btn\" name=\"search-bar-submit-btn\" class=\"formSubmit is-srOnly\" type=\"submit\">\n\n            <button class=\"formSubmitBtn\">\n              <svg height=\"20\" role=\"img\" aria-labelledby=\"searchicontitle  searchicondesc\"  xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" x=\"0px\" y=\"0px\" viewBox=\"0 0 413.1 413.1\" enable-background=\"new 0 0 413.1 413.1\" xml:space=\"preserve\">\n               <title id=\"searchicontitle\">Magnifying glass image</title>\n               <desc id=\"searchicondesc\">Large red circle with a black border</desc>\n                <path d=\"M289.5,49.6c-66.1-66.2-173.8-66.2-239.9,0c-66.1,66.1-66.1,173.8,0,239.9c63.9,63.9,166.4,66.1,233,6.6l13.5,13.5\n  \t\t\t\t\t\t\t\t\t\t\t\tc-3.4,8.6-1.6,18.7,5.3,25.6l71,71c9.3,9.3,24.5,9.3,33.8,0c9.3-9.3,9.3-24.5,0-33.8l-71-71c-6.9-6.9-17-8.7-25.6-5.3l-13.5-13.5\n  \t\t\t\t\t\t\t\t\t\t\t\tC355.6,216,353.4,113.5,289.5,49.6z M69.9,269.3c-55-55-55-144.4,0-199.4c55-55,144.4-55,199.4,0s55,144.4,0,199.4\n  \t\t\t\t\t\t\t\t\t\t\t\tS124.9,324.2,69.9,269.3z\"></path>\n                <path d=\"M103.4,102.1c24-24,51.9-41.4,81.3-52.3c-33.2-1.9-68.8,11-96.2,38.4c-27.7,27.7-40.6,63.9-38.2,97.6 C61,155.6,78.7,126.8,103.4,102.1z\"></path>\n              </svg>\n            </button>\n\n        </div>\n    </fieldset>\n</form>\n\n<div class=\"quickSearch searchfloyout\">\n  <section class=\"quickSearchResults\" data-bind=\"html: results\"></section>\n</div><!--.quickSearch ends-->\n\n<div class=\"searchproduct-holder\">\n\n      {{#if theme_settings.gb-quicksearch-search-featured }}\n      <div class=\"searchfeatured-products\">\n          <h3>Featured</h3>\n          <ul>\n          {{#each (limit products.featured 5) }}\n              <li class=\"searchproduct-list\">\n                <a href=\"{{url}}\">\n                  <div class=\"searchproduct-img\">\n                    {{> components/common/responsive-img\n                        image=image\n                        class=\"card-image\"\n                        fallback_size=theme_settings.productgallery_size\n                        lazyload=theme_settings.lazyload_mode\n                        default_image=theme_settings.default_image_product\n                    }}\n                  </div>\n                  <div class=\"searchproduct-name\">\n                    {{name}}\n                  </div>\n                </a>\n              </li>\n          {{/each}}\n          </ul>\n      </div><!--.searchfeatured-products ends-->\n      {{/if}}\n\n      {{#if theme_settings.gb-quicksearch-search-popular }}\n      <div class=\"searchpopular-products\">\n          <h3>Most Popular</h3>\n          <ul>\n          {{#each (limit products.top_sellers 5) }}\n              <li class=\"searchproduct-list\">\n                  <a href=\"{{url}}\">\n                    <div class=\"searchproduct-img\">\n                      {{> components/common/responsive-img\n                          image=image\n                          class=\"card-image\"\n                          fallback_size=theme_settings.productgallery_size\n                          lazyload=theme_settings.lazyload_mode\n                          default_image=theme_settings.default_image_product\n                      }}\n                    </div>\n                    <div class=\"searchproduct-name\">\n                      {{name}}\n                    </div>\n                  </a>\n              </li>\n          {{/each}}\n          </ul>\n      </div><!--.searchpopular-products ends-->\n      {{/if}}\n\n      {{#if theme_settings.gb-quicksearch-search-latest }}\n      <div class=\"searchlatest-products\">\n        <h3>Latest</h3>\n        <ul>\n        {{#each (limit products.new 5) }}\n            <li class=\"searchproduct-list\">\n              <a href=\"{{url}}\">\n                <div class=\"searchproduct-img\">\n                  {{> components/common/responsive-img\n                      image=image\n                      class=\"card-image\"\n                      fallback_size=theme_settings.productgallery_size\n                      lazyload=theme_settings.lazyload_mode\n                      default_image=theme_settings.default_image_product\n                  }}\n                </div>\n                <div class=\"searchproduct-name\">\n                  {{name}}\n                </div>\n              </a>\n            </li>\n        {{/each}}\n        </ul>\n      </div><!--.searchlatest-products ends-->\n      {{/if}}\n\n</div><!--.searchproduct-holder ends-->\n\n","components/gordonbyte/common/search-icon":"<svg role=\"img\" aria-labelledby=\"quicksearchicontitle  quicksearchicondesc\" height=\"20\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" x=\"0px\" y=\"0px\" viewBox=\"0 0 413.1 413.1\" enable-background=\"new 0 0 413.1 413.1\" xml:space=\"preserve\">\n\t<title id=\"quicksearchicontitle\">Magnifying glass image</title>\n\t<desc id=\"quicksearchicondesc\">Large red circle with a black border</desc>\n\t<path d=\"M289.5,49.6c-66.1-66.2-173.8-66.2-239.9,0c-66.1,66.1-66.1,173.8,0,239.9c63.9,63.9,166.4,66.1,233,6.6l13.5,13.5\n\t\t\t\t\t\t\t\t\t  c-3.4,8.6-1.6,18.7,5.3,25.6l71,71c9.3,9.3,24.5,9.3,33.8,0c9.3-9.3,9.3-24.5,0-33.8l-71-71c-6.9-6.9-17-8.7-25.6-5.3l-13.5-13.5\n\t\t\t\t\t\t\t\t\t  C355.6,216,353.4,113.5,289.5,49.6z M69.9,269.3c-55-55-55-144.4,0-199.4c55-55,144.4-55,199.4,0s55,144.4,0,199.4\n\t\t\t\t\t\t\t\t\t  S124.9,324.2,69.9,269.3z\"></path>\n\t<path d=\"M103.4,102.1c24-24,51.9-41.4,81.3-52.3c-33.2-1.9-68.8,11-96.2,38.4c-27.7,27.7-40.6,63.9-38.2,97.6 C61,155.6,78.7,126.8,103.4,102.1z\"></path>\n  </svg>\n"}
